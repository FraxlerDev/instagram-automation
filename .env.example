# Meta / Instagram credentials. Keep .env private.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_APP_ID=

# Create any long random value. This same value goes into Meta Webhooks.
WEBHOOK_VERIFY_TOKEN=change-this-to-a-long-random-value

# Set after Cloudflare Tunnel prints its https:// URL.
PUBLIC_BASE_URL=

# Only these Instagram media IDs are automated. Comma-separated.
# Leave empty until you deliberately select a test post; empty means process none.
ALLOWED_MEDIA_IDS=

# Bot behaviour.
TRIGGER_KEYWORDS=гайд,гайда,гайду,гайдом,гайди,ґайд,ґайда,ґайду,ґайдом,ґайди
CONFIRMATION_WORDS=готово
PUBLIC_REPLY_TEXT=Написав вам у Direct 😊
INITIAL_DM_TEXT=Привіт! Щоб отримати файл, підпишись на @your_account та напиши у відповідь слово «ГОТОВО».
GUIDE_MESSAGE_TEXT=Ось твій файл

# Runtime.
GRAPH_API_VERSION=v26.0
HOST=127.0.0.1
PORT=8000
ADMIN_PORT=8795
ADMIN_HOST=127.0.0.1
ADMIN_ALLOWED_NETWORKS=127.0.0.0/8
GUIDE_PDF_PATH=assets/guide.pdf
DB_PATH=data/bot.sqlite3
SIGNATURE_REQUIRED=true
